<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SpreadsheetGen</PackageId>
    <Authors>Tsingis</Authors>
    <Version>0.1.0</Version>
    <Description>Package for quickly creating spreadsheets</Description>
    <PackageIcon>logo.png</PackageIcon>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/Tsingis/SpreadsheetGen</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Tsingis/SpreadsheetGen</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>false</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\LICENSE.md" Pack="true" PackagePath="" />
    <None Include="..\resources\logo.png" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
